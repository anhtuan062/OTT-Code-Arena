{
  "name": "ott-code-arena",
  "version": "0.1.0",
  "description": "OTT Code Arena - Programming competition platform for OTTv2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build-html.js && node scripts/build-frontend.js && tsc && tsc-alias --resolve-full-paths",
    "build:html": "node scripts/build-html.js",
    "build:frontend": "node scripts/build-frontend.js",
    "build:public": "node scripts/build-html.js && node scripts/build-frontend.js && node scripts/build-public.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "predev": "node scripts/build-html.js",
    "dev": "tsx watch server/index.ts",
    "dev:qa": "node scripts/build-html.js && tsx scripts/start-qa-server.ts",
    "engine:test": "vitest run tests/engine"
  },
  "keywords": [
    "ott",
    "game",
    "arena",
    "bot",
    "competition"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "12.4.1",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
