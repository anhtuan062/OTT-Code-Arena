{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["engine/*"],
      "@bot-protocol/*": ["bot-protocol/*"],
      "@bot-runner/*": ["bot-runner/*"],
      "@bot-executor/*": ["bot-executor/*"],
      "@match-runner/*": ["match-runner/*"],
      "@tournament/*": ["tournament/*"]
    }
  },
  "include": ["engine/**/*", "bot-protocol/**/*", "bot-runner/**/*", "bot-executor/**/*", "match-runner/**/*", "tournament/**/*", "server/**/*"],
  "exclude": ["node_modules", "dist", "examples", "tests"]
}